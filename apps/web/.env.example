BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CORS_ORIGIN=

# Admin (/admin)
ADMIN_PASSWORD=

# Supabase (table public.clients)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Diagnostic (/diagnostic) : webhook n8n qui écrit le lead dans NocoDB.
# L'appel est synchrone, le workflow doit répondre après l'insertion.
LEAD_WEBHOOK_URL=https://n8n.mysynapsis.fr/webhook/leads-SEO
# Secret partagé, vérifié par n8n dans l'en-tête X-Webhook-Secret.
LEAD_WEBHOOK_SECRET=

# Nouveau diagnostic -> Pilotage (n8n V-01b). Serveur uniquement : jamais en NEXT_PUBLIC_.
# Si l'une des deux manque, rien n'est envoyé et une erreur est journalisée.
N8N_WEBHOOK_DIAGNOSTIC=https://n8n.mysynapsis.fr/webhook/diagnostic-site
# Envoyé dans l'en-tête X-Webhook-Secret.
N8N_WEBHOOK_SECRET=
